{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./types",
    "baseUrl": "./src",
    "rootDir": "./src",
    "paths": {
      // Resolve against the built declarations (types:web / types:copy-server-
      // functions run earlier in the pipeline). frames/package.json names this
      // nested package "@solidjs/web/frames", so under NodeNext the parent
      // "@solidjs/web" self-reference rule never applies — and a fresh install
      // has no node_modules/@solidjs/web to fall back on (dev checkouts that
      // ran the `link` script have a symlink, which is why this passes locally).
      "@solidjs/web": ["../../types/index.d.ts"],
      "@solidjs/web/server-functions/client": [
        "../../types/server-functions/client.d.ts"
      ]
    }
  },
  "include": ["./src"]
}
