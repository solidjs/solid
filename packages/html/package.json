{
  "name": "@solidjs/html",
  "description": "Tagged-template-literal templating for Solid — write components with no build step.",
  "version": "2.0.0-rc.8",
  "author": "Ryan Carniato",
  "license": "MIT",
  "homepage": "https://solidjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs/solid.git",
    "directory": "packages/html"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/html.js",
  "module": "./dist/html.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "types",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/html.js"
    }
  },
  "scripts": {
    "build": "npm-run-all -nl build:*",
    "build:clean": "rimraf dist/ coverage/",
    "build:js": "rollup -c",
    "types": "npm-run-all -nl types:clean types:html",
    "types:clean": "rimraf types/",
    "types:html": "tsc --project ./tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.8"
  },
  "devDependencies": {
    "@solidjs/web": "workspace:*",
    "solid-js": "workspace:*"
  }
}
