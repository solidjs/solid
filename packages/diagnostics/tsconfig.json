{
  "compilerOptions": {
    "target": "esnext",
    "newLine": "LF",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["vitest/globals", "node"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests"],
  "exclude": ["dist", "node_modules"]
}
