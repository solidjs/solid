{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./.types-build",
    "rootDir": ".",
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "strictPropertyInitialization": false,
    "types": ["node"],
    "paths": {
      "@solidjs/web": ["./src/index.ts"],
      "@solidjs/web/server-functions/client": ["./server-functions/src/client.ts"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.d.ts",
    "./serialization/src/**/*.ts",
    "./server-functions/src/**/*.ts",
    "./frames/src/**/*.ts"
  ],
  "exclude": ["./src/jsx-template.d.ts", "./src/jsx-h.d.ts"]
}
