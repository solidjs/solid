  // `solid-js` that its declarations strip, rc.22's `heldRead`).
  "extends": "../../tsconfig.test.json",
  "compilerOptions": { "skipLibCheck": false, "types": [] },
  "include": ["./test/published-types.libcheck.ts"]
}
