{
  "name": "chat-example",
  "description": "An AI chat as live Solid Server Components: threads rendered on the server and streamed as HTML, with generation as a job that outlives the request that started it",
  "version": "0.0.0",
  "private": true,
  "author": "Ryan Carniato",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "check:server": "node scripts/check-server.mjs"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.38",
    "@solidjs/web": "workspace:*",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.2",
    "solid-js": "workspace:*",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.49",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vite": "^8.0.0"
  }
}
