{
  "name": "@solidjs/universal",
  "description": "Solid's universal runtime for creating custom renderers",
  "version": "2.0.0-rc.8",
  "author": "Ryan Carniato",
  "license": "MIT",
  "homepage": "https://solidjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs/solid.git",
    "directory": "packages/universal"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/universal.js",
  "module": "./dist/universal.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "types",
    "package.json"
  ],
  "exports": {
    ".": {
      "development": {
        "types": "./types/index.d.ts",
        "default": "./dist/universal.dev.js"
      },
      "observe": {
        "types": "./types/index.d.ts",
        "default": "./dist/universal.observe.js"
      },
      "types": "./types/index.d.ts",
      "default": "./dist/universal.js"
    },
    "./types/*": "./types/*"
  },
  "scripts": {
    "build": "npm-run-all -nl build:*",
    "build:clean": "rimraf dist/ coverage/",
    "build:js": "rollup -c",
    "types": "npm-run-all -nl types:clean types:universal",
    "types:clean": "rimraf types/",
    "types:universal": "tsc --project ./tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.8"
  },
  "devDependencies": {
    "solid-js": "workspace:*"
  }
}
