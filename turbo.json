{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": ["JSX_COMPILER"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^types"],
      "outputLogs": "new-only"
    },
    "@solidjs/signals#build": {
      "outputs": ["dist/**"]
    },
    "@solidjs/signals#types": {
      "outputs": ["dist/types/**"]
    },
    "@solidjs/diagnostics#build": {
      "dependsOn": ["@solidjs/signals#build", "@solidjs/signals#types"],
      "outputs": ["dist/**"]
    },
    "solid-js#build": {
      "dependsOn": ["@solidjs/signals#build", "@solidjs/signals#types"],
      "outputs": ["dist/**", "**/dist/**"]
    },
    "solid-js#types": {
      "dependsOn": ["@solidjs/signals#types"],
      "outputs": ["types/**", "**/types/**"]
    },
    "@solidjs/web#link": {
      "dependsOn": ["solid-js#build"],
      "outputs": []
    },
    "@solidjs/web#build": {
      "dependsOn": ["solid-js#types", "@solidjs/web#link", "@solidjs/web#types"],
      "outputs": ["dist/**", "**/dist/**"]
    },
    "@solidjs/h#link": {
      "dependsOn": ["@solidjs/web#build"],
      "outputs": []
    },
    "@solidjs/h#build": {
      "dependsOn": ["@solidjs/web#types", "@solidjs/h#link"],
      "outputs": ["dist/**", "**/dist/**"]
    },
    "@solidjs/element#build": {
      "dependsOn": ["solid-js#types", "@solidjs/web#types"]
    },
    "types": {
      "dependsOn": ["^types"],
      "outputs": ["types/**", "**/types/**"]
    },
    "@solidjs/web#types": {
      "dependsOn": ["^types"],
      "outputs": ["types/**", "**/types/**", "jsx/jsx.d.ts", "jsx/jsx-properties.d.ts"]
    },
    "coverage": {
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^types"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "@solidjs/signals#test": {
      "dependsOn": ["@solidjs/signals#build"],
      "outputs": []
    },
    "solid-js#test": {
      "dependsOn": ["@solidjs/signals#build", "solid-js#build"],
      "outputs": []
    },
    "@solidjs/web#test": {
      "dependsOn": ["solid-js#build", "@solidjs/web#build"],
      "outputs": []
    },
    "@solidjs/h#test": {
      "dependsOn": ["@solidjs/web#build", "@solidjs/h#build"],
      "outputs": []
    },
    "@solidjs/html#test": {
      "dependsOn": ["@solidjs/web#build", "@solidjs/html#build"],
      "outputs": []
    },
    "@solidjs/universal#test": {
      "dependsOn": ["solid-js#build", "@solidjs/universal#build"],
      "outputs": []
    },
    "@solidjs/babel-plugin#build": {
      "outputs": ["index.js"]
    },
    "@solidjs/babel-plugin#test": {
      "dependsOn": ["@solidjs/babel-plugin#build"],
      "outputs": []
    },
    "@solidjs/compiler#test": {
      "cache": false
    },
    "test-integration#test": {
      "dependsOn": [
        "@solidjs/signals#build",
        "solid-js#build",
        "@solidjs/web#build",
        "@solidjs/h#build",
        "@solidjs/html#build",
        "@solidjs/universal#build"
      ]
    },
    "solid-js#test-types": {
      "outputs": [],
      "dependsOn": ["types"]
    },
    "@solidjs/web#test-types": {
      "outputs": [],
      "dependsOn": ["types"]
    }
  }
}
