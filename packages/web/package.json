{
  "name": "@solidjs/web",
  "description": "Solid's web runtime: client rendering, hydration, SSR, and DOM-specific control flow (Portal, Dynamic).",
  "version": "2.0.0-rc.7",
  "author": "Ryan Carniato",
  "license": "MIT",
  "homepage": "https://solidjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs/solid.git",
    "directory": "packages/web"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "unpkg": "./dist/web.js",
  "jsdelivr": "./dist/web.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "types",
    "package.json",
    "storage/dist",
    "storage/types",
    "storage/package.json",
    "serialization/dist",
    "serialization/types",
    "serialization/package.json",
    "serialization/decode/package.json",
    "server-functions/dist",
    "server-functions/package.json",
    "server-functions/rich-args/package.json",
    "frames/dist",
    "frames/package.json"
  ],
  "exports": {
    ".": {
      "worker": {
        "development": {
          "types": "./types/index.d.ts",
          "default": "./dist/server.dev.js"
        },
        "types": "./types/index.d.ts",
        "default": "./dist/server.js"
      },
      "browser": {
        "development": {
          "types": "./types/index.d.ts",
          "default": "./dist/web.dev.js"
        },
        "observe": {
          "types": "./types/index.d.ts",
          "default": "./dist/web.observe.js"
        },
        "types": "./types/index.d.ts",
        "default": "./dist/web.js"
      },
      "deno": {
        "development": {
          "types": "./types/index.d.ts",
          "default": "./dist/server.dev.js"
        },
        "types": "./types/index.d.ts",
        "default": "./dist/server.js"
      },
      "node": {
        "development": {
          "types": "./types/index.d.ts",
          "default": "./dist/server.dev.js"
        },
        "types": "./types/index.d.ts",
        "default": "./dist/server.js"
      },
      "development": {
        "types": "./types/index.d.ts",
        "default": "./dist/web.dev.js"
      },
      "observe": {
        "types": "./types/index.d.ts",
        "default": "./dist/web.observe.js"
      },
      "types": "./types/index.d.ts",
      "default": "./dist/web.js"
    },
    "./jsx-runtime": {
      "types": "./types/jsx.d.ts",
      "default": "./dist/web.js"
    },
    "./jsx-dev-runtime": {
      "types": "./types/jsx.d.ts",
      "default": "./dist/web.dev.js"
    },
    "./storage": {
      "types": "./storage/types/index.d.ts",
      "default": "./storage/dist/storage.js"
    },
    "./serialization": {
      "types": "./serialization/types/index.d.ts",
      "default": "./serialization/dist/serialization.js"
    },
    "./serialization/decode": {
      "types": "./serialization/types/serializer-decode.d.ts",
      "default": "./serialization/dist/decode.js"
    },
    "./server-functions": {
      "worker": {
        "development": {
          "types": "./types/server-functions/server.d.ts",
          "default": "./server-functions/dist/server.dev.js"
        },
        "types": "./types/server-functions/server.d.ts",
        "default": "./server-functions/dist/server.js"
      },
      "browser": {
        "types": "./types/server-functions/client.d.ts",
        "default": "./server-functions/dist/client.js"
      },
      "deno": {
        "development": {
          "types": "./types/server-functions/server.d.ts",
          "default": "./server-functions/dist/server.dev.js"
        },
        "types": "./types/server-functions/server.d.ts",
        "default": "./server-functions/dist/server.js"
      },
      "node": {
        "development": {
          "types": "./types/server-functions/server.d.ts",
          "default": "./server-functions/dist/server.dev.js"
        },
        "types": "./types/server-functions/server.d.ts",
        "default": "./server-functions/dist/server.js"
      },
      "types": "./types/server-functions/client.d.ts",
      "default": "./server-functions/dist/client.js"
    },
    "./server-functions/server": {
      "development": {
        "types": "./types/server-functions/server.d.ts",
        "default": "./server-functions/dist/server.dev.js"
      },
      "types": "./types/server-functions/server.d.ts",
      "default": "./server-functions/dist/server.js"
    },
    "./server-functions/client": {
      "types": "./types/server-functions/client.d.ts",
      "default": "./server-functions/dist/client.js"
    },
    "./server-functions/rich-args": {
      "types": "./types/server-functions/rich-args.d.ts",
      "default": "./server-functions/dist/rich-args.js"
    },
    "./frames": {
      "worker": {
        "development": {
          "types": "./types/frames/server.d.ts",
          "default": "./frames/dist/server.dev.js"
        },
        "types": "./types/frames/server.d.ts",
        "default": "./frames/dist/server.js"
      },
      "browser": {
        "development": {
          "types": "./types/frames/client.d.ts",
          "default": "./frames/dist/client.dev.js"
        },
        "types": "./types/frames/client.d.ts",
        "default": "./frames/dist/client.js"
      },
      "deno": {
        "development": {
          "types": "./types/frames/server.d.ts",
          "default": "./frames/dist/server.dev.js"
        },
        "types": "./types/frames/server.d.ts",
        "default": "./frames/dist/server.js"
      },
      "node": {
        "development": {
          "types": "./types/frames/server.d.ts",
          "default": "./frames/dist/server.dev.js"
        },
        "types": "./types/frames/server.d.ts",
        "default": "./frames/dist/server.js"
      },
      "development": {
        "types": "./types/frames/client.d.ts",
        "default": "./frames/dist/client.dev.js"
      },
      "types": "./types/frames/client.d.ts",
      "default": "./frames/dist/client.js"
    },
    "./frames/server": {
      "development": {
        "types": "./types/frames/server.d.ts",
        "default": "./frames/dist/server.dev.js"
      },
      "types": "./types/frames/server.d.ts",
      "default": "./frames/dist/server.js"
    },
    "./frames/client": {
      "types": "./types/frames/client.d.ts",
      "default": "./frames/dist/client.js"
    },
    "./types/*": "./types/*"
  },
  "scripts": {
    "build": "npm-run-all -nl build:clean types:copy-jsx build:js",
    "build:clean": "rimraf dist/",
    "build:js": "rollup -c",
    "link": "symlink-dir . node_modules/@solidjs/web",
    "types": "npm-run-all -nl types:clean types:copy-jsx types:web types:copy-web types:web-storage",
    "types:clean": "rimraf types/ storage/types/ serialization/types/ frames/types/ .types-build/",
    "jsx-sync": "node ./scripts/jsx-sync.mjs --compile --element \"SolidElement | Node | ArrayElement\" --import \"import type { Element as SolidElement } from \\\"solid-js\\\";\"",
    "types:copy-jsx": "pnpm run jsx-sync",
    "types:web": "tsc --project ./tsconfig.build.json",
    "types:copy-web": "node ./scripts/copy-types.mjs",
    "types:web-storage": "tsc --project ./storage/tsconfig.build.json",
    "test": "vitest run && vitest run --config vite.config.server.mjs && vitest run --config vite.config.hydrate.mjs",
    "test:server": "vitest run --config vite.config.server.mjs",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "bench:server": "vitest bench --run --config vite.config.server-bench.mjs",
    "test-types": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "seroval": "~1.6.7",
    "seroval-plugins": "~1.6.7"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.7"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.4.0",
    "@solidjs/signals": "workspace:*",
    "solid-js": "workspace:*"
  }
}
